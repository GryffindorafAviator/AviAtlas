# Recommended for free development testing. Put your key in .env, not here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional alternative: direct OpenAI or another Responses-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional absolute directory for documents.sqlite3, chroma/, and uploads/.
# Default: backend/data (independent of the current working directory).
# AVIATLAS_DATA_DIR=/absolute/path/to/aviatlas-data
