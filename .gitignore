# Python core cache and virtual environment
.venv/
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/

# Environment variables (contains sensitive info like API keys)
.env

# OS files
.DS_Store

# Local vector database (ChromaDB generated data)
chroma_db/
test_chroma_db/

# Test PDF files (prevent large and copyrighted files from being committed)
*.pdf

# IDE configs (prevent committing personal editor settings)
.vscode/
.idea/

# Ignore personal/local exploration scripts
scripts/playground/